
package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;
import org.apache.log4j.*;
import rs.ac.bg.etf.pp1.ast.*;

parser code {:
	
	boolean errorDetected;
	
	Logger log = Logger.getLogger(getClass());
   
    // slede redefinisani metodi za prijavu gresaka radi izmene teksta poruke
     
    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
      done_parsing();
      report_error(message, info);
    }
  
    public void syntax_error(Symbol cur_token) {
        report_error("\nSintaksna greska", cur_token);
    }
  
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatalna greska, parsiranje se ne moze nastaviti", cur_token);
    }

    public void report_error(String message, Object info) {
    	errorDetected = true;
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" na liniji ").append(((Symbol)info).left);
        log.error(msg.toString());
    }


:}


init with {:
	errorDetected = false;
:}

scan with {:
	Symbol s = this.getScanner().next_token();
	if (s != null && s.value != null) 
		log.info(s.toString() + " " + s.value.toString());
	return s;
:}


terminal PROG, BREAK, ENUM, CLASS, ABSTRACT, ELSE, CONST, IF, NEW, PRINT, READ, RETURN, VOID, EXTENDS, CONTINUE, FOR, LEN, SWITCH, CASE, TRUE, FALSE;
terminal PLUS, MINUS, STAR, DIV, MOD, EQUAL, LESS, GREATER, COLON, SEMI, COMMA, PERIOD, QMARK, EMARK, LPAREN, RPAREN, LBRACE, RBRACE, LBRACK, RBRACK;
terminal AMPER, VLINE, PLUSPLUS, MINUSMINUS, EQUALEQUAL, NOTEQUAL, GREATEREQUAL, LESSEQUAL, AMPERAMPER, VLINEVLINE;
terminal int NUMBER;
terminal String IDENT;
terminal char CHARCONST;

nonterminal rs.etf.pp1.symboltable.concepts.Obj ProgName, Program;
nonterminal ProgDeclElemList, ProgDeclElem;

nonterminal ConstDecl, ConstDeclElem, ConstDeclType, ConstDeclElemList;

nonterminal VarDecl, VarDeclElem, LastVarDeclElem, VarDeclElemList, VarDeclList, Elems;

nonterminal EnumDeclElem, EnumDeclElemList;
nonterminal rs.etf.pp1.symboltable.concepts.Obj EnumDecl, EnumDeclName;

nonterminal ClassDecl, ExtendsClassDecl, MethodDeclClassDecl, MethodDeclListClassDecl;

nonterminal AbstractClassDecl, AbstractMethodDeclAbstractClassDecl;

nonterminal MethodDecl, TypeMethodDecl, FormParsMethodDecl, MethodDeclList;

nonterminal AbstractMethodDecl, AbstractMethodDeclList;

nonterminal FormPars, FormParsElem, LastFormParsElem, FormParsElemList;

nonterminal Statement, StatementList, CaseList, ForStatement, DSElemForStatement, CElemForStatement, IfBlockStart;

nonterminal DesignatorStatement;

nonterminal ActPars;

nonterminal Condition;

nonterminal CondTerm, CondTermList;

nonterminal CondFact, CondFactList;

nonterminal Expr, ExprList, NoTernaryExpr, HasTernaryExpr;

nonterminal Term, TermList;

nonterminal Factor, FactorList, ActParsFactor, ParenExprFactor;

nonterminal Designator, DesignatorElemList, DesignatorElem;

nonterminal Assignop, Relop, Addop, Mulop;

nonterminal NumConst, CharConst, BoolConst;

nonterminal rs.etf.pp1.symboltable.concepts.Struct Type, VarDeclType;

precedence left ELSE;







Program ::= (Program) PROG ProgName ProgDeclElemList LBRACE MethodDeclList RBRACE;

ProgName ::= (ProgName) IDENT:name;

ProgDeclElemList ::= (HasProgDeclElemList) ProgDeclElemList ProgDeclElem
					 |
					 (NoProgDeclElemList)/* epsilon */
					 ;

ProgDeclElem ::= (ConstProgDeclElem) ConstDecl
				 |
				 (VarProgDeclElem) VarDecl
				 |
				 (ClassProgDeclElem) ClassDecl
				 |
				 (EnumProgDeclElem) EnumDecl
				 |
				 (AbstractClassProgDeclElem) AbstractClassDecl
				 ;

ConstDecl ::= (ConstDecl) CONST ConstDeclType:type ConstDeclElem ConstDeclElemList SEMI;

ConstDeclType ::= (ConstDeclType) Type:type;

ConstDeclElemList ::= (HasConstDeclElemList) ConstDeclElemList COMMA ConstDeclElem
					  |
					  (NoConstDeclElemList) /* epsilon */
					  ;

ConstDeclElem ::= (NumConstDeclElem) IDENT:name EQUAL NumConst:numConst
				  |
				  (CharConstDeclElem) IDENT:name EQUAL CharConst:charConst
				  |
				  (BoolConstDeclElem) IDENT:name EQUAL BoolConst:boolConst
				  ;


VarDecl ::= (HasVarDecl) VarDeclType:t VarDeclElemList:vdel;

VarDeclType ::= (VarDeclType) Type;

VarDeclElem ::= (BrackVarDeclElem) IDENT:name LBRACK RBRACK COMMA
				|
				(NoBrackVarDeclElem) IDENT:name COMMA
				|
				(ErrorVarDeclElem) error COMMA:l
				{: parser.report_error("Izvrsen VarDecl oporavak do , u liniji " + lleft, null); :}
				;

LastVarDeclElem ::= (BrackLastVarDeclElem) IDENT:name LBRACK RBRACK SEMI
					 |
					 (NoBrackLastVarDeclElem) IDENT:name SEMI
					 |
					 (ErrorLastVarDeclElem) error SEMI:l
					 {: parser.report_error("Izvrsen VarDecl oporavak do ; u liniji " + lleft, null); :}
					 ;

VarDeclElemList ::= (HasVarDeclElemList) VarDeclElem VarDeclElemList
					|
					(LastVarDeclElemList) LastVarDeclElem
					;

VarDeclList ::= (HasVarDeclList) VarDeclList VarDecl
				|
				(NoVarDeclList) /* epsilon */
				|
				error:l SEMI
				{: parser.report_error("Izvrsen VarDeclList oporavak do ; u liniji " + lleft, null); :}
				|
				error:l COMMA
				{: parser.report_error("Izvrsen VarDeclList oporavak do , u liniji " + lleft, null); :}
				;



EnumDecl ::= (EnumDecl) ENUM EnumDeclName:name LBRACE EnumDeclElem EnumDeclElemList RBRACE;

EnumDeclName ::= (EnumDeclName) IDENT:name;

EnumDeclElemList ::= (HasEnumDeclElemList) EnumDeclElemList COMMA EnumDeclElem
					 |
					 (NoEnumDeclElemList) /* epsilon */
					 ;

EnumDeclElem ::= (NoValEnumDeclElem) IDENT:name
				 |
				 (ValEnumDeclElem) IDENT:name EQUAL NumConst:num
				 ;




ClassDecl ::= (ClassDecl) CLASS IDENT ExtendsClassDecl LBRACE VarDeclList MethodDeclClassDecl RBRACE;

ExtendsClassDecl ::= (HasExtendsClassDecl) EXTENDS Type
					 |
					 (NoExtendsClassDecl) /* epsilon */
					 |
					 EXTENDS error:l LBRACE
					 {: parser.report_error("Izvrsen Extends oporavak do } u liniji " + lleft, null); :}
					 ;

MethodDeclClassDecl ::= (HasMethodDeclClassDecl) LBRACE MethodDeclListClassDecl RBRACE
						|
						(NoMethodDeclClassDecl) /* epsilon */
						;

MethodDeclListClassDecl ::= (HasMethodDeclListClassDecl) MethodDeclListClassDecl MethodDecl
							|
							(NoMethodDeclListClassDecl) /* epsilon */
							;


AbstractClassDecl ::= (AbstractClassDecl) ABSTRACT CLASS IDENT ExtendsClassDecl LBRACE VarDeclList AbstractMethodDeclAbstractClassDecl RBRACE;

AbstractMethodDeclAbstractClassDecl ::= (HasAMDAbstractClassDecl) LBRACE AbstractMethodDeclList RBRACE
										 |
										 (NoAMDAbstractClassDecl) /* epsilon */
										 ;


MethodDecl ::= (MethodDecl) TypeMethodDecl IDENT LPAREN FormParsMethodDecl RPAREN VarDeclList LBRACE StatementList RBRACE;

TypeMethodDecl ::= (TMethodDecl) Type
				   |
				   (VMethodDecl) VOID
				   ;

FormParsMethodDecl ::= (HasFormParsMethodDecl) FormPars
					   |
					   (NoFormParsMethodDecl) /* epsilon */
					   ;

MethodDeclList ::= (HasMethodDeclList) MethodDeclList MethodDecl
				   |
				   (NoMethodDeclList) /* epsilon */
				   ;



AbstractMethodDecl ::= (AbstractMethodDecl) ABSTRACT TypeMethodDecl IDENT LPAREN FormParsMethodDecl RPAREN;

AbstractMethodDeclList ::= (HasMAbstractMethodDeclList) AbstractMethodDeclList MethodDecl
						   |
						   (HasAMAbstractMethodDeclList) AbstractMethodDeclList AbstractMethodDecl SEMI
						   |
						   (NoAbstractMethodDeclList) /* epsilon */
						   ;



FormPars ::= (FormPars) FormParsElemList;

FormParsElem ::= (BrackFormParsElem) Type IDENT LBRACK RBRACK COMMA
				 |
				 (NoBrackFormParsElem) Type IDENT COMMA
				 |
				 (ErrorFormParsElem)error:l COMMA
				 {: parser.report_error("Izvrsen FormParsElem oporavak do , u liniji " + lleft, null); :}
				 ;

LastFormParsElem ::= (BrackLastFormParsElem) Type IDENT LBRACK RBRACK
					 |
					 (NoBrackLastFormParsElem) Type IDENT
					 |
					 (ErrorLastFormParsElem) error:l
					 {: parser.report_error("Izvrsen LastFormParsElem oporavak do ) u liniji " + lleft, null); :}
					 ;

FormParsElemList ::= (HasFormParsElem) FormParsElem FormParsElemList
					 |
					 (NoFormParsElem) LastFormParsElem
					 ;




Statement ::= (DesignatorStatementStatement) DesignatorStatement SEMI
			  |
			  (IfElseStatement) IfBlockStart Statement ELSE Statement
			  |
			  (IfStatement) IfBlockStart Statement
			  |
			  (BStatement) BREAK SEMI
			  |
			  (CStatement) CONTINUE SEMI
			  |
			  (ExprRStatement) RETURN Expr SEMI
			  |
			  (NoExprRStatement) RETURN SEMI
			  |
			  (RStatement) READ LPAREN Designator RPAREN SEMI
			  |
			  (NumConstPStatement) PRINT LPAREN Expr COMMA NumConst RPAREN SEMI
			  |
			  (PStatement) PRINT LPAREN Expr RPAREN SEMI
			  |
			  (SWStatement) SWITCH LPAREN Expr RPAREN LBRACE CaseList RBRACE
			  |
			  (FStatement) ForStatement
			  |
			  (SLStatement) LBRACE StatementList RBRACE
			  ;

IfBlockStart ::= (HasIfBlockStart) IF LPAREN Condition RPAREN
				 |
				 (ErrorIfBlockStart) IF LPAREN error:l RPAREN
				 {: parser.report_error("Izvrsen IfBlock oporavak do ) u liniji " + lleft, null); :}
				 ;

CaseList ::= (HasCaseList) CaseList CASE NumConst COLON StatementList
			 |
			 (NoCaseList) /* epsilon */
			 ;

ForStatement ::= (ForStatement) FOR LPAREN DSElemForStatement SEMI CElemForStatement SEMI DSElemForStatement RPAREN Statement;

DSElemForStatement ::= (HasDSElemForStatement) DesignatorStatement
					   |
					   (NoDSElemForStatement) /* epsilon */
					   ;

CElemForStatement ::= (HasCElemForStatement) Condition
					  |
					  (NoCElemForStatement) /* epsilon */
					  ;

StatementList ::= (HasStatementList) StatementList Statement
				  |
				  (NoStatementList) /* epsilon */
				  ;



DesignatorStatement ::= (AssignopDesignatorStatement) Designator Assignop Expr
						|
						(ActParsDesignatorStatement) Designator LPAREN ActPars RPAREN
						|
						(NoActParsDesignatorStatement) Designator LPAREN RPAREN
						|
						(PlusPlusDesignatorStatement) Designator PLUSPLUS
						|
						(MinusMinusDesignatorStatement) Designator MINUSMINUS
						|
						(ErrorDesignatorStatement)error:l
						{: parser.report_error("Izvrsen DesignatorStatement oporavak do ; u liniji " + lleft, null); :}
						;



ActPars ::= (ActPars) ExprList;



Condition ::= (Condition) CondTermList;



CondTerm ::= (CondTerm) CondFactList;

CondTermList ::= (HasCondTermList) CondTermList VLINEVLINE CondTerm
				 |
				 (NoCondTermList) CondTerm
				 ;



CondFact ::= (ExprCondFact) NoTernaryExpr Relop NoTernaryExpr
			 |
			 (NoExprCondFact) NoTernaryExpr
			 ;

CondFactList ::= (HasCondFactList) CondFactList AMPERAMPER CondFact
				 |
				 (NoCondFactList) CondFact
				 ;



Expr ::= (NoTExpr) NoTernaryExpr
		 |
		 (HasTExpr) HasTernaryExpr
		 ;

NoTernaryExpr ::= (MinusExpr) MINUS TermList
				  |
				  (NoMinusExpr) TermList
				  ;
				  
HasTernaryExpr ::= (TernaryExpr) Condition QMARK NoTernaryExpr COLON Expr;

ExprList ::= (HasExprList) ExprList COMMA Expr
			 |
			 (NoExprList) Expr
			 ;


Term ::= (Term) FactorList;

TermList ::= (HasTermList) Term Addop TermList
			 |
			 (NoTermList) Term
			 ;



Factor ::= (DesignatorActParsFactor) Designator ActParsFactor
		   |
		   (NumFactor) NumConst
		   |
		   (CharFactor) CharConst
		   |
		   (BoolFactor) BoolConst
		   |
		   (NewExprFactor)NEW Type LBRACK Expr RBRACK 
		   |
		   (NewNoExprFactor)NEW Type
		   |
		   (ExprFactor) ParenExprFactor
		   ;

ParenExprFactor ::= (ParenExprFactor) LPAREN Expr RPAREN;


FactorList ::= (HasFactorList) FactorList Mulop Factor
			   |
			   (NoFactorList) Factor
			   ;

ActParsFactor ::= (ParenNoActParsFactor) LPAREN RPAREN
				  |
				  (ParenActParsFactor) LPAREN ActPars RPAREN
				  |
				  (NoParenNoActParsFactor) /* epsilon */
				  ;

Designator ::= (Designator) IDENT DesignatorElemList;


DesignatorElemList::= (HasDesignatorElem) DesignatorElemList DesignatorElem
					  |
					  (NoDesignatorElem) /* epsilon */
					  ;
				  

DesignatorElem ::= (DotIdentDesignatorElem) PERIOD IDENT
				   |
				   (DotLengthDesignatorElem) PERIOD LEN
				   |
				   (ExprDesignatorElem) LBRACK Expr RBRACK
				   ;

 

Assignop ::= (Assignop) EQUAL;



Relop ::= (RelopEqualEqual) EQUALEQUAL
		  |
		  (RelopNotEqual) NOTEQUAL
		  |
		  (RelopGreater) GREATER
		  |
		  (RelopGreaterEqual) GREATEREQUAL
		  |
		  (RelopLess) LESS
		  |
		  (RelopLessEqual) LESSEQUAL
		  ;


Addop ::= (AddopPlus) PLUS
		  |
		  (AddopMinus) MINUS
		  ;



Mulop ::= (MulopStar) STAR
		  |
		  (MulopDiv) DIV
		  |
		  (MulopMod) MOD
		  ;



Type ::= (Type) IDENT:typeName;


NumConst ::= (NumConst) NUMBER:val;


CharConst ::= (CharConst) CHARCONST:val;


BoolConst ::= (TrueBoolConst) TRUE:val
			  |
			  (FalseBoolConst) FALSE:val
			  ;
			  
			  