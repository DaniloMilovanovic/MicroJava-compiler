
package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;
import org.apache.log4j.*;
import rs.ac.bg.etf.pp1.ast.*;

parser code {:

	Logger log = Logger.getLogger(getClass());
   
    // slede redefinisani metodi za prijavu gresaka radi izmene teksta poruke
     
    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
      done_parsing();
      report_error(message, info);
    }
  
    public void syntax_error(Symbol cur_token) {
        report_error("\nSintaksna greska", cur_token);
    }
  
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatalna greska, parsiranje se ne moze nastaviti", cur_token);
    }

    public void report_error(String message, Object info) {
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" na liniji ").append(((Symbol)info).left);
        log.error(msg.toString());
    }


:}


scan with {:
	Symbol s = this.getScanner().next_token();
	if (s != null && s.value != null) 
		log.info(s.toString() + " " + s.value.toString());
	return s;
:}


terminal PROG, BREAK, ENUM, CLASS, ABSTRACT, ELSE, CONST, IF, NEW, PRINT, READ, RETURN, VOID, EXTENDS, CONTINUE, FOR, LEN, SWITCH, CASE;
terminal PLUS, MINUS, STAR, DIV, MOD, EQUAL, LESS, GREATER, COLON, SEMI, COMMA, PERIOD, QMARK, EMARK, APOST, LPAREN, RPAREN, LBRACE, RBRACE, LBRACK, RBRACK;
terminal AMPER, VLINE, PLUSPLUS, MINUSMINUS, EQUALEQUAL, NOTEQUAL, GREATEREQUAL, LESSEQUAL, AMPERAMPER, VLINEVLINE;
terminal int NUMBER;
terminal String IDENT;

nonterminal Program;

nonterminal Designator, DesignatorList, DesignatorElem;
nonterminal Relop, Addop, Mulop;
nonterminal Expr;

Designator ::= (Designator) IDENT DesignatorList;


DesignatorList::= (HasDesignatorElem) DesignatorList DesignatorElem
				  |
				  (NoDesignatorElem) /* epsilon */
				  ;
				  

DesignatorElem ::= (DotIdentDesignatorElem) PERIOD IDENT
				   |
				   (DotLengthDesignatorElem) PERIOD LEN
				   |
				   (ExprDesignatorElem) LBRACK Expr RBRACK
				   ;
				   

Relop ::= (RelopEqualEqual) EQUALEQUAL
		  |
		  (RelopNotEqual) NOTEQUAL
		  |
		  (RelopGreater) GREATER
		  |
		  (RelopGreaterEqual) GREATEREQUAL
		  |
		  (RelopLess) LESS
		  |
		  (RelopLessEqual) LESSEQUAL
		  ;


Addop ::= (AddopPlus) PLUS
		  |
		  (AddopMinus) MINUS
		  ;


Mulop ::= (MulopStar) STAR
		  |
		  (MulopDiv) DIV
		  |
		  (MulopMod) MOD
		  ;
