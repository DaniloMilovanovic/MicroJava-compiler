program testFor

int i, j;
int sum;
{
    void main() {
        // Osnovna for petlja
        for(i = 0; i < 5; i++) {
            print(i);
            print(eol);
        }
        print(eol);

        // Suma sa for petljom
        sum = 0;
        for(i = 1; i <= 5; i++) {
            sum = sum + i;
        }
        print(sum);
        print(eol);
        print(eol);

        // For bez inicijalizacije
        i = 0;
        for(; i < 3; i++) {
            print(i);
            print(eol);
        }
        print(eol);

        // For sa break
        for(i = 0; i < 10; i++) {
            if(i == 4) break;
            print(i);
            print(eol);
        }
        print(eol);

        // For sa continue
        for(i = 0; i < 5; i++) {
            if(i == 2) continue;
            print(i);
            print(eol);
        }

        print(eol);
        // For u for petlji

        for(i = 0; i < 3; i++){
            print(i);
            print(eol);
            print(eol);
            for(j = 0; j < 6; j++){
                print(j);
                print(eol);
            }
            print(eol);
        }
    }
}